APP_NAME="Bin Mishal Travels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database - Use MySQL for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=binmishal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@binmishal.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Payment Gateways
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_ENVIRONMENT=test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# EXTERNAL SERVICE INTEGRATIONS - Fill in credentials as needed
# =============================================================================

# AI Chat Assistant (Phase 16) - Choose one provider
OPENAI_API_KEY=                   # Required for OpenAI GPT integration
ANTHROPIC_API_KEY=                # Required for Anthropic Claude integration

# WhatsApp Business API (Phase 18)
WHATSAPP_API_TOKEN=               # Required for WhatsApp Broadcast

# Google Analytics & Marketing (Phase 7)
GA_MEASUREMENT_ID=                # e.g., G-XXXXXXXXXX
GTM_CONTAINER_ID=                 # e.g., GTM-XXXXXXX
GOOGLE_ADSENSE_ID=               # e.g., ca-pub-xxxxxxxxxx
METABASE_PIXEL_ID=                # Facebook/Meta Pixel ID

# ZATCA E-Invoicing (Phase 19 - Recommended for Saudi compliance)
ZATCA_API_KEY=                    # Required when ZATCA integration is implemented

# Biometric Device (Phase 12) - Hardware SDK credentials
BIOMETRIC_API_ENDPOINT=            # URL for biometric device API
BIOMETRIC_API_KEY=                 # API key for biometric service

# External Accounting Software (Phase 14 - Optional)
ACCOUNTING_API_KEY=               # QuickBooks/Zoho/Tally API key
ACCOUNTING_PROVIDER=               # quickbooks, zoho, or tally
